-- Murder Duels auto shoot (genuine path, no mouse, mobile ok)
-- Calls the game's own RevolverClient shoot() (same fn normal clicks use),
-- which raycasts from camera + fires ShootReplicate + SpawnBullet.
-- No mouse1click / VIM / hooks / spy. Runs automatically on execute.

local _STATE_INJECTED = nil
pcall(function()
    local g = getgenv and getgenv() or _G
    _STATE_INJECTED = g["STATE"]
end)
if _STATE_INJECTED == nil then
    pcall(function() _STATE_INJECTED = _G["STATE"] end)
end
local STATE_T
if typeof(_STATE_INJECTED) == "table" then
    STATE_T = _STATE_INJECTED
else
    STATE_T = {
        _clean = {},
    }
    function STATE_T.onCleanup(fn) table.insert(STATE_T._clean, fn) end
    function STATE_T.connect(sig, fn)
        local ok, c = pcall(function() return sig:Connect(fn) end)
        if ok and c then
            table.insert(STATE_T._clean, c)
            return c
        end
        return nil
    end
    function STATE_T.alive() return _G.MDAS_ALIVE ~= false end
    _G.MDAS_ALIVE = true
end
local S = STATE_T

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local FIRE_GAP = 0.28
local IDLE_WAIT = 0.15

_G.MDAS_ENABLED = true

local function getShootFn()
    if typeof(filtergc) ~= "function" then return nil end
    local ok, f = pcall(function()
        return filtergc("function", { Name = "shoot" }, true)
    end)
    if ok and typeof(f) == "function" then return f end
    return nil
end

local function inMatch()
    local ok, v = pcall(function() return LP:GetAttribute("InMatch") end)
    if ok and v == true then return true end
    local ok2, team = pcall(function() return LP.Team and LP.Team.Name end)
    if ok2 and team and team ~= "Lobby" then return true end
    return false
end

local function ensureRevolver()
    local char = LP.Character
    if not char then return end
    if char:FindFirstChild("Revolver") then return end
    local bp = LP:FindFirstChild("Backpack")
    local tool = bp and bp:FindFirstChild("Revolver")
    if not tool then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:EquipTool(tool) end) end
end

local function tryShootOnce()
    if not inMatch() then return false end
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    ensureRevolver()
    local f = getShootFn()
    if not f then return false end
    local ok = pcall(f)
    return ok
end

task.spawn(function()
    while S.alive() do
        if _G.MDAS_ENABLED then
            tryShootOnce()
            task.wait(FIRE_GAP)
        else
            task.wait(IDLE_WAIT)
        end
    end
end)

print("[MDAS] auto-shoot loaded. genuine shoot(), no clicks.")
