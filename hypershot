end

function KillAllState.roundLive(): boolean
	local ok, live = pcall(function()
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local im = pg and pg:FindFirstChild("InMatchUI")
		local rnd = im and im:FindFirstChild("Round")
		local cd = rnd and rnd:FindFirstChild("Countdown")
		local tt = cd and cd:FindFirstChild("TimerText")
		if tt and tt:IsA("TextLabel") and tt.Visible then
			local t = tostring(tt.Text or "")
			t = t:gsub("%s+", "")
			if t == "4" or t == "3" or t == "2" or t == "1" then
				return false
			end
		end
		return true
	end)
	if ok then
