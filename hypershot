local function getLocalChar(): Model?
	local chars = Workspace:FindFirstChild("Characters")
	if chars then
		local m = chars:FindFirstChild(LocalPlayer.Name)
		if m and m:IsA("Model") then return m end
	end
	return LocalPlayer.Character
end

local function isVisible(targetPart: BasePart, _targetModel: Model): boolean
	if not AimState.WallCheck then return true end
	local myChar = getLocalChar()
	local origin = Camera.CFrame.Position
	local dir = targetPart.Position - origin
	local dist = dir.Magnitude
	if dist < 1 then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local ignore: { Instance } = { Camera }
	if myChar then table.insert(ignore, myChar) end
	params.FilterDescendantsInstances = ignore
	local res = Workspace:Raycast(origin, dir.Unit * dist, params)
	if res == nil or res.Instance == nil then return true end
	if res.Instance:IsDescendantOf(_targetModel) then return true end
	return false
end

local function getAimWorldPos(model: Model): Vector3?
	local part = model:FindFirstChild(AimState.AimPartName)
	if not part or not part:IsA("BasePart") then return nil end
	local pos: Vector3 = part.Position
	if AimState.Prediction > 0 then
		local hrp = model:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			local ok, vel = pcall(function() return hrp.AssemblyLinearVelocity end)
			if ok and typeof(vel) == "Vector3" then
				pos += (vel :: Vector3) * AimState.Prediction
			end
		end
	end
	return pos
end

local function getClosestTarget(): (Model?, Vector2?, string?, Vector3?)
	local chars = Workspace:FindFirstChild("Characters")
	if not chars then return nil, nil, nil, nil end
	local vs = Camera.ViewportSize
	local center = Vector2.new(vs.X / 2, vs.Y / 2)
	local best: Model? = nil
	local bestScreen: Vector2? = nil
	local bestWorld: Vector3? = nil
	local bestDist = AimState.FOV
	local bestName = ""
	for _, m in ipairs(chars:GetChildren()) do
		if m:IsA("Model") and isEnemyStrict(m) then
			local worldPos = getAimWorldPos(m)
			if worldPos then
				local camDist = (worldPos - Camera.CFrame.Position).Magnitude
				if camDist <= AimState.MaxDistance then
					local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
					if onScreen then
						local s2 = Vector2.new(sp.X, sp.Y)
						local d = (s2 - center).Magnitude
						if d <= bestDist then
							local part = m:FindFirstChild(AimState.AimPartName)
							if part and part:IsA("BasePart") and isVisible(part, m) then
								best = m
								bestScreen = s2
								bestWorld = worldPos
								bestDist = d
								bestName = m.Name
							end
						end
					end
				end
			end
		end
	end
	return best, bestScreen, bestName, bestWorld
end

