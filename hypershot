	local fakeLoadout = {}

	local function rebuildFake(pageIdx)
		table.clear(fakeLoadout)
		local ids = PAGES[pageIdx]
		for i = 1, PAGE_SIZE do
			local id = ids[i]
			if id then
				local isRealIcon = (id == "Icon")
				fakeLoadout[i] = {
					ItemId = id,
					InstanceId = isRealIcon and realGuid or ("spoof-" .. id),
					Spoofed = not isRealIcon,
				}
			else
				fakeLoadout[i] = nil
			end
		end
	end

	local curTrack, curSound, curDef = nil, nil, nil
	local function stopEmote()
		if curTrack then pcall(function() curTrack:Stop(0.15) end) end
		curTrack, curDef = nil, nil
		if curSound then
			local s = curSound
			curSound = nil
			pcall(function() s:Stop() end)
			pcall(function() s:Destroy() end)
		end
		pcall(function() emotePreview.StopStage() end)
	end

	local lastPlay = 0
	local function playEmote(emoteId)
		local now = tick()
		if now - lastPlay < 0.6 then return false, "TooFast" end
		lastPlay = now
		stopEmote()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local animator = hum and hum:FindFirstChildOfClass("Animator")
		if not animator then return false, "NoAnimator" end
		if not hum or hum.Health <= 0 then return false, "Dead" end
		local def = emoteCatalog.Get and emoteCatalog.Get(emoteId) or emoteCatalog.Defs[emoteId]
		if not def then return false, "NoDef" end
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(def.Anim)
		local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
		pcall(function() anim:Destroy() end)
		if not ok or not track then return false, "LoadFail" end
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = (def.Loop == true)
		pcall(function() track:Play(0.15, 1, 1) end)
		curTrack = track
		curDef = def
		pcall(function()
			track.Stopped:Connect(function()
				if curTrack == track then
					if def.SfxTail then curTrack, curDef = nil, nil
					else stopEmote() end
				end
			end)
		end)
		local sfxId = def.Sfx
		if type(sfxId) == "table" then sfxId = sfxId[math.random(1, #sfxId)] end
		if sfxId then
			local host = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char
			local s = Instance.new("Sound")
			s.Name = "EmoteSfx_" .. tostring(emoteId)
			s.SoundId = "rbxassetid://" .. tostring(sfxId)
			s.Volume = tonumber(def.SfxVolume) or 0.5
			local pitch = tonumber(def.SfxPitch) or 1
			local var = tonumber(def.SfxPitchVar) or 0
			if var > 0 then pitch = pitch + (math.random() * 2 - 1) * var end
			s.PlaybackSpeed = pitch
			s.Looped = (def.Loop == true)
			s.RollOffMode = Enum.RollOffMode.InverseTapered
			s.RollOffMaxDistance = 150
			s.RollOffMinDistance = 8
			s.EmitterSize = 8
			s.Parent = host
			pcall(function() s:Play() end)
			curSound = s
			local fadeAt = tonumber(def.SfxFadeOutAt)
			if fadeAt then
				task.delay(fadeAt, function()
					if curSound == s then
						local t = tonumber(def.SfxFadeTime) or 0.6
						pcall(function() TweenService:Create(s, TweenInfo.new(t), {Volume = 0}):Play() end)
						task.delay(t + 0.05, function()
							if curSound == s then
								pcall(function() s:Stop() end)
								pcall(function() s:Destroy() end)
								curSound = nil
							end
						end)
					end
				end)
			end
		end
		return true
	end

