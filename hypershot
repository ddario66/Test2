	if typeof(getgenv) == "function" then
		local ok, g = pcall(function() return getgenv() end)
		if ok and type(g) == "table" and g ~= _G then
			table.insert(envs, g)
		end
	end
	for _, env in ipairs(envs) do
		if env._ddariuspr_conns then
			for _, c in ipairs(env._ddariuspr_conns) do pcall(function() c:Disconnect() end) end
		end
		env._ddariuspr_conns = {}
	end
end)
local function trackConn(c)
	pcall(function()
		local env: any = _G
		if typeof(getgenv) == "function" then
			local ok, g = pcall(function() return getgenv() end)
			if ok and type(g) == "table" then
				env = g
			end
		end
		env._ddariuspr_conns = env._ddariuspr_conns or {}
		table.insert(env._ddariuspr_conns, c)
	end)
	if RSTATE and RSTATE.connect then pcall(function() RSTATE.connect(c) end) end
	return c
end
