function KillAllState.cooldownLeft(): number
	local start: any = nil
	local dur: any = nil
	pcall(function()
		start = LocalPlayer:GetAttribute("Ability2CooldownStartedAt")
		dur = LocalPlayer:GetAttribute("Ability2CooldownDuration")
	end)
	if type(start) ~= "number" or type(dur) ~= "number" then return 0 end
	if dur ~= dur then return 0 end
	if dur == math.huge then
		local active = false
		pcall(function()
			if KA_AEC ~= nil then active = KA_AEC.GetActiveFor("bullet", "Barrage") ~= nil end
		end)
		if active then return 0 end
		return math.huge
	end
	if dur <= 0 then return 0 end
	local remain = (start + dur) - os.clock()
	if remain < 0 then remain = 0 end
	return remain
end

function KillAllState.fxOn(): boolean
	if KA_AEC == nil then return false end
	local ok, fx = pcall(function() return KA_AEC.GetActiveFor("bullet", "Barrage") end)
