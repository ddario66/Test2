local Move = GUI:Tab("Move", "🏃")
local MoveSec = Move:Section("🏃 SLIDE")

local SlideState = {
	Enabled = false,
	Speed = 35,
	Time = 0.9,
	MaxForce = 50000,
}

local slideLV = nil
local slideTrack = nil
local slideAnimId = nil
local slideCharRef = nil
local slideBurstUntil = 0

local SLIDE_ANIMS = {
	Lobby = "rbxassetid://94135099449363",
	Match = "rbxassetid://110411750155166",
}

local slideInputMap = nil
pcall(function()
	slideInputMap = require(game.ReplicatedStorage.Extensions.InputMap)
end)

local function slideGetChar()
	local folder = workspace:FindFirstChild("Characters")
	local c = folder and folder:FindFirstChild(LocalPlayer.Name)
	if c and c.Parent then return c end
	return nil
end

local function slideEnsureLV(hrp)
	local attach = hrp:FindFirstChild("BurstSlideAttachment")
	if not attach then return nil end
	if slideLV and slideLV.Parent == hrp and slideLV.Attachment0 == attach then return slideLV end
	if slideLV then pcall(function() slideLV:Destroy() end) slideLV = nil end
	local nlv = Instance.new("LinearVelocity")
	nlv.Name = "InfiniteSlideLV"
	nlv.Attachment0 = attach
	nlv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	nlv.MaxAxesForce = Vector3.new(SlideState.MaxForce, 0, SlideState.MaxForce)
	nlv.RelativeTo = Enum.ActuatorRelativeTo.World
	nlv.VectorVelocity = Vector3.new(0, 0, 0)
	nlv.Parent = hrp
	slideLV = nlv
	return slideLV
end

local function slideRemoveLV()
	if slideLV then pcall(function() slideLV:Destroy() end) slideLV = nil end
end

local function slideStopAnim()
	if slideTrack then pcall(function() slideTrack:Stop(0.15) end) end
	slideTrack = nil
	slideAnimId = nil
end

local function slideEnsureAnim(char)
	local wantId = SLIDE_ANIMS.Match
	pcall(function()
		if LocalPlayer.Team and LocalPlayer.Team.Name == "Lobby" then wantId = SLIDE_ANIMS.Lobby end
	end)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then return nil end
	if slideTrack and slideAnimId == wantId then return slideTrack end
	slideStopAnim()
	local ok, track = pcall(function()
		local a = Instance.new("Animation")
		a.AnimationId = wantId
		local t = animator:LoadAnimation(a)
		t.Priority = Enum.AnimationPriority.Action
		t.Looped = true
		return t
	end)
	if ok and track then
		slideTrack = track
		slideAnimId = wantId
		return track
	end
	return nil
end

local function slideDir(char, hum, hrp)
	local md = hum.MoveDirection
	if md.Magnitude > 0.1 then
		return Vector3.new(md.X, 0, md.Z).Unit
	end
	local look = hrp.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.01 then return flat.Unit end
	return nil
end

local function slideStartBurst()
	if not SlideState.Enabled then return end
	local char = slideGetChar()
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then return end
	if hum.FloorMaterial == Enum.Material.Air then return end
	slideBurstUntil = os.clock() + SlideState.Time
end

local function slideCrouchHeld()
	if slideInputMap then
		local ok, down = pcall(function() return slideInputMap.isDown("Crouch") end)
		if ok and down then return true end
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.C) then return true end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then return true end
	local gp = false
	pcall(function()
		if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonB) then
			gp = true
		end
	end)
	return gp
end

trackConn(UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if not SlideState.Enabled then return end
	if input.KeyCode == Enum.KeyCode.C
		or input.KeyCode == Enum.KeyCode.LeftControl
		or input.KeyCode == Enum.KeyCode.ButtonB then
		slideStartBurst()
	end
end))

trackConn(RunService.Heartbeat:Connect(function()
	if not _alive then return end
	local char = slideGetChar()
	if not char then
		slideRemoveLV() slideStopAnim() slideCharRef = nil slideBurstUntil = 0
		return
	end
	if char ~= slideCharRef then
		slideRemoveLV() slideStopAnim() slideCharRef = char slideBurstUntil = 0
	end
	if not SlideState.Enabled then
		slideRemoveLV() slideStopAnim()
		return
	end
	if slideCrouchHeld() then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 and hum.FloorMaterial ~= Enum.Material.Air then
			slideBurstUntil = os.clock() + SlideState.Time
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then
		slideRemoveLV() slideStopAnim()
		return
	end
	if os.clock() > slideBurstUntil or hum.FloorMaterial == Enum.Material.Air then
		slideRemoveLV() slideStopAnim()
		return
	end
	local dir = slideDir(char, hum, hrp)
	if not dir then
		slideRemoveLV() slideStopAnim()
		return
	end
	local velocity = slideEnsureLV(hrp)
	if velocity then
		velocity.VectorVelocity = dir * SlideState.Speed
	end
	local track = slideEnsureAnim(char)
	if track and not track.IsPlaying then
		pcall(function() track:Play(0.1) end)
	end
end))

trackConn(Gui.Destroying:Connect(function()
	slideRemoveLV()
	slideStopAnim()
end))

MoveSec:Toggle("Remove Slide Cooldown", false, function(v)
	SlideState.Enabled = v
	if not v then
		slideRemoveLV()
		slideStopAnim()
		slideBurstUntil = 0
	end
	Notify("Move", "Remove Slide Cooldown " .. (v and "ON" or "OFF"), v and T.Green or T.Red)
end)

