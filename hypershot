-- UNIFIED NAMECALL HOOK
function KillAllState.ensureHook()
	if KillAllState.hooked then return end
	KillAllState.hooked = true

	local function applyPacketMods(self, args)
		local packet = args[1]
		if type(packet) ~= "table" then return end
		local name = tostring(self.Name or "")
		local lname = string.lower(name)

		local isBullet = (name == "ShootReplicate" or name == "SpawnBullet")
			or string.find(lname, "shoot", 1, true) ~= nil
			or string.find(lname, "bullet", 1, true) ~= nil
		local isKnife = (name == "ThrowReplicate" or name == "SpawnKnife")
			or string.find(lname, "knife", 1, true) ~= nil
			or string.find(lname, "throw", 1, true) ~= nil
		if not (isBullet or isKnife) then return end

		local t: BasePart? = nil
		if KillAllState.Enabled and KillAllState.Target and KillAllState.Target.Parent then
			t = KillAllState.Target
		elseif WALLBANG and wallbangTarget and wallbangTarget.Parent then
			t = wallbangTarget
		elseif SilentState.Enabled and silentTarget and silentTarget.Parent then
			t = silentTarget
		end
		if not t then return end

		if isBullet then
			packet.hitInstance    = t
			packet.hitPos         = t.Position
			packet.to             = t.Position
			packet.isCharacterHit = true
			packet.origin         = t.Position + Vector3.new(0, 1, 0)
			if type(packet.segments) == "table" then
				for _, seg in ipairs(packet.segments) do
					if type(seg) == "table" then
						seg.hitInstance    = t
						seg.hitPos         = t.Position
						seg.isCharacterHit = true
					end
				end
			end
		elseif isKnife then
			packet.target = t.Position
			packet.origin = t.Position + Vector3.new(0, 1, 0)
		end
	end

	local installed = false
	pcall(function()
		if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
			local oldNamecall
			oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
				local args = {...}
				pcall(function()
					local method = getnamecallmethod()
					if method == "FireServer" or method == "Fire" or method == "InvokeServer" then
						local isExploitCall = false
						if type(checkcaller) == "function" then isExploitCall = checkcaller() end
						if not isExploitCall then
							applyPacketMods(self, args)
						end
					end
				end)
				return oldNamecall(self, ...)
			end)
			installed = true
		end
	end)

	if not installed then
		warn("[ddariuspr gui] hookmetamethod unavailable — Silent Aim / Wallbang running in camera-assisted fallback mode.")
	end
end

