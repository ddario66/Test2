function KillAllState.ensureHook()
	if KillAllState.hooked then
		return
	end
	KillAllState.hooked = true
	pcall(function()
		if hookmetamethod and getnamecallmethod and checkcaller then
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			local method = getnamecallmethod()
			if not checkcaller() then
				local args = {...}
				local packet = args[1]
				if type(packet) == "table" then
					local name = self.Name
					if method == "FireServer" or method == "Fire" or method == "InvokeServer" then
						local isBullet = (name == "ShootReplicate" or name == "SpawnBullet")
						local isKnife  = (name == "ThrowReplicate" or name == "SpawnKnife")

						if isBullet or isKnife then
							local kaActive = KillAllState.Enabled and KillAllState.Target and KillAllState.Target.Parent
							if kaActive then
								local t = KillAllState.Target
								if isBullet then
									packet.hitInstance    = t
									packet.hitPos         = t.Position
									packet.to             = t.Position
									packet.isCharacterHit = true
									packet.origin         = t.Position + Vector3.new(0, 1, 0)
									if type(packet.segments) == "table" then
										for _, seg in ipairs(packet.segments) do
											if type(seg) == "table" then
												seg.hitInstance    = t
												seg.hitPos         = t.Position
												seg.isCharacterHit = true
											end
										end
									end
								elseif isKnife then
									packet.target = t.Position
									packet.origin = t.Position + Vector3.new(0, 1, 0)
								end
							elseif WALLBANG and wallbangTarget and wallbangTarget.Parent then
								local t = wallbangTarget
								if isBullet then
									packet.hitInstance    = t
									packet.hitPos         = t.Position
									packet.to             = t.Position
									packet.isCharacterHit = true
									packet.origin         = t.Position + Vector3.new(0, 1, 0)
									if type(packet.segments) == "table" then
										for _, seg in ipairs(packet.segments) do
											if type(seg) == "table" then
												seg.hitInstance    = t
												seg.hitPos         = t.Position
												seg.isCharacterHit = true
											end
										end
									end
								elseif isKnife then
									packet.target = t.Position
									packet.origin = t.Position + Vector3.new(0, 1, 0)
								end
							elseif SilentState.Enabled and silentTarget and silentTarget.Parent then
								local t = silentTarget
								if isBullet then
									packet.hitInstance    = t
									packet.hitPos         = t.Position
									packet.to             = t.Position
									packet.isCharacterHit = true
									if type(packet.segments) == "table" then
										for _, seg in ipairs(packet.segments) do
											if type(seg) == "table" then
												seg.hitInstance    = t
												seg.hitPos         = t.Position
												seg.isCharacterHit = true
											end
										end
									end
								elseif isKnife then
									packet.target = t.Position
								end
							end
						end
					end
				end
			end
			return oldNamecall(self, ...)
			end)
		end
	end)
end

