		local cat = Shared:WaitForChild("EmoteCatalog", 5)
		local ec = Shared:WaitForChild("EmoteClient", 5)
		local ep = Shared:WaitForChild("EmotePreview", 5)
		if cat and ec and ep then
			emoteCatalog = require(cat)
			emoteClient = require(ec)
			emotePreview = require(ep)
