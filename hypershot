local function ka_runOnce(): boolean
	if not KillAllState.inMatch() then
		local now = os.clock()
		if now - KillAllState.lastMatchWarn >= KillAllState.WARN_GAP then
			KillAllState.lastMatchWarn = now
			Notify("Kill All", "waiting for match...", T.Yellow)
		end
		return false
	end
	if not KillAllState.roundLive() then
		local now = os.clock()
		if now - KillAllState.lastRoundWarn >= KillAllState.WARN_GAP then
			KillAllState.lastRoundWarn = now
			Notify("Kill All", "waiting for round start...", T.Yellow)
		end
		return false
	end
	if KillAllState.AUTO_EQUIP_GUN then
		local eqBind = ka_bindingFor("EquipRevolver") or "Two"
		local eqItem = ka_resolveInput(eqBind)
		if eqItem ~= nil then ka_pressKey(eqItem) else ka_tapAction("EquipRevolver") end
		task.wait(0.3)
	end
	if not KillAllState.Enabled or not _alive then return false end
	if not KillAllState.isBarrage() then
		local now = os.clock()
		if now - KillAllState.lastWarn >= KillAllState.WARN_GAP then
			KillAllState.lastWarn = now
			Notify("Kill All", "u dont have equipped bullet barrage", T.Red)
		end
		return false
	end
	if KillAllState.fxOn() then
		task.wait(KillAllState.SETTLE)
		if not KillAllState.Enabled or not _alive then return false end
		if KillAllState.Target == nil or KillAllState.Target.Parent == nil then return true end
		KillAllState.snap()
		ka_fireOnce()
		return true
	end
	local remain = KillAllState.cooldownLeft()
	if remain > 0.05 then return false end
	ka_castAbility("CastAbility2")
	local seen = ka_waitForBulletEffect("Barrage", KillAllState.CAST_TIMEOUT)
	if not KillAllState.Enabled or not _alive then return false end
	if not seen then return false end
	task.wait(KillAllState.SETTLE)
	if KillAllState.Target == nil or KillAllState.Target.Parent == nil then return false end
	KillAllState.snap()
	ka_fireOnce()
	return true
end

local function ka_startLoop()
	if KillAllState.running then return end
	KillAllState.running = true
	task.spawn(function()
		while KillAllState.Enabled and _alive do
			local ok, fired = pcall(ka_runOnce)
			if not KillAllState.Enabled or not _alive then break end
			if ok and fired then
				task.wait(KillAllState.IDLE_WAIT)
			else
				if not KillAllState.inMatch() then task.wait(1)
				elseif not KillAllState.roundLive() then task.wait(KillAllState.POLL)
				elseif not KillAllState.isBarrage() then task.wait(KillAllState.RETRY_WAIT)
				else task.wait(KillAllState.POLL) end
			end
		end
		KillAllState.running = false
	end)
end

