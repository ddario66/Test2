		hideEspSet(s)
	end
end

local espConn = RunService.RenderStepped:Connect(function()
	pcall(function()
		if not EspState.Enabled then
			if next(espCache) ~= nil then hideAllEsp() end
			return
		end

		Camera = Workspace.CurrentCamera
		local chars = Workspace:FindFirstChild("Characters")
		local seen: { [Model]: boolean } = {}
		if chars then
			local myChar = getLocalChar()
			for _, m in ipairs(chars:GetChildren()) do
				if m:IsA("Model") and isEnemyStrict(m) then
					local head = m:FindFirstChild("Head")
					local hrp = m:FindFirstChild("HumanoidRootPart")
					local hum = m:FindFirstChildOfClass("Humanoid")
					if head and head:IsA("BasePart") and hrp and hrp:IsA("BasePart") and hum then
						local dist = (head.Position - Camera.CFrame.Position).Magnitude
						if dist <= EspState.MaxDistance then
							local top3 = head.Position + Vector3.new(0, 0.7, 0)
							local bot3 = hrp.Position - Vector3.new(0, 3.2, 0)
							local top, topOn = Camera:WorldToViewportPoint(top3)
							local bot, botOn = Camera:WorldToViewportPoint(bot3)
							if topOn and botOn then
								seen[m] = true
								local h = math.abs(bot.Y - top.Y)
								if h > 4 and h < 2000 then
									local wdt = h * 0.55
									local cx = (top.X + bot.X) / 2
									local vis = true
									do
										local params = RaycastParams.new()
										params.FilterType = Enum.RaycastFilterType.Exclude
										params.IgnoreWater = true
										local ign: { Instance } = { Camera }
										if myChar then table.insert(ign, myChar) end
										params.FilterDescendantsInstances = ign
										local org = Camera.CFrame.Position
										local dd = hrp.Position - org
										local rr = Workspace:Raycast(org, dd.Unit * dd.Magnitude, params)
										if rr and rr.Instance and not rr.Instance:IsDescendantOf(m) then
											vis = false
										end
									end
									local col = if vis then EspState.VisColor else EspState.HidColor
									local s = espCache[m]
									if not s then
										s = newEspSet()
										espCache[m] = s
									end
									s.container.Visible = true

									if EspState.ShowBox then
										s.box.Visible = true
										s.box.Position = UDim2.fromOffset(math.floor(cx - wdt / 2), math.floor(top.Y))
										s.box.Size = UDim2.fromOffset(math.floor(wdt), math.floor(h))
										s.boxStroke.Color = col
									else
										s.box.Visible = false
									end

									if EspState.ShowHealth then
										local f = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
										local bh = h * f
										s.hbBg.Visible = true
										s.hbBg.Size = UDim2.fromOffset(4, math.floor(h))
										s.hbBg.Position = UDim2.fromOffset(math.floor(cx - wdt / 2 - 6), math.floor(top.Y))
										s.hb.Size = UDim2.fromOffset(4, math.max(1, math.floor(bh)))
										s.hb.Position = UDim2.fromOffset(math.floor(cx - wdt / 2 - 6), math.floor(top.Y + (h - bh)))
										s.hb.BackgroundColor3 = if f > 0.5 then Color3.fromRGB(80, 255, 80)
											elseif f > 0.25 then Color3.fromRGB(255, 200, 60)
											else Color3.fromRGB(255, 60, 60)
										s.hb.Visible = true
									else
										s.hbBg.Visible = false
										s.hb.Visible = false
									end

									if EspState.ShowName or EspState.ShowDistance then
										local t = m.Name
										if EspState.ShowDistance then
											t ..= " [" .. math.floor(dist) .. "m]"
										end
										s.label.Text = t
										s.label.Size = UDim2.fromOffset(200, 16)
										s.label.Position = UDim2.fromOffset(math.floor(cx - 100), math.floor(top.Y - 18))
										s.label.Visible = true
									else
										s.label.Visible = false
									end
								end
							end
						end
					end
				end
			end
		end
		for model, s in pairs(espCache) do
			if not seen[model] then
				hideEspSet(s)
				if model.Parent == nil then
					freeEspSet(s)
					espCache[model] = nil
				end
			end
		end
	end)
end)
