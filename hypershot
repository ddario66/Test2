				if nameLbl and nameLbl:IsA("TextLabel") then nameLbl.Text = def and (def.Name or id) or id end
				if plus then plus.Visible = false end
				if rig then
					for _, c in ipairs(rig:GetChildren()) do pcall(function() c:Destroy() end) end
					pcall(function() emotePreview.new(rig, id, {autoplay = true, loop = true}) end)
				end
