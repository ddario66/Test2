local function fitScale()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vs = cam.ViewportSize
	if IS_MOBILE then
		Scale.Scale = math.clamp(math.min(vs.X / 900, vs.Y / 620), 0.65, 1)
	else
		Scale.Scale = math.clamp(math.min(vs.X / 800, vs.Y / 560), 0.55, 1)
	end
end
pcall(fitScale)
pcall(function()
	local cam = workspace.CurrentCamera
	if cam then trackConn(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() pcall(fitScale) end)) end
end)
