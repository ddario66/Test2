end)

local function ka_bindingFor(action: string): string?
	if KA_InputMap ~= nil then
		local ok, binds = pcall(function() return KA_InputMap.getBindings(action) end)
		if ok and typeof(binds) == "table" and #binds > 0 then
			return binds[1]
		end
	end
	return nil
end

local function ka_resolveInput(nameStr: string): EnumItem?
	local ok, item = pcall(function()
		local shared = RStorage:WaitForChild("Shared", 5)
		local KS = require(shared:WaitForChild("KeybindSettings", 5))
		return KS.resolve(nameStr)
	end)
	if ok and item ~= nil then return item end
	local kc = (Enum.KeyCode :: any)[nameStr]
	if kc ~= nil then return kc end
	return nil
end

local function ka_pressKey(item: EnumItem): boolean
	if vim ~= nil and item.EnumType == Enum.KeyCode then
		local ok = pcall(function()
			vim:SendKeyEvent(true, item, false, game)
			task.wait(0.05)
			vim:SendKeyEvent(false, item, false, game)
		end)
		if ok then return true end
	end
	return false
end

local function ka_tapAction(action: string): boolean
	if KA_InputMap ~= nil then
		local ok = pcall(function() KA_InputMap.tap(action) end)
		return ok
	end
	return false
end

local function ka_castAbility(action: string): string
	local bindName = ka_bindingFor(action) or (if action == "CastAbility2" then "E" else "Q")
	local item = ka_resolveInput(bindName)
	if item ~= nil and ka_pressKey(item) then
		return "key " .. bindName
	end
	if ka_tapAction(action) then
		return "tap " .. action
	end
	return "FAILED"
end

local function ka_bulletEffectId(): string?
	local id: string? = nil
	pcall(function()
		local raw = LocalPlayer:GetAttribute("Ability2Id")
		if typeof(raw) == "string" and raw ~= "" then
			id = string.gsub(raw, "Bullet$", "")
		end
	end)
	if id == nil or id == "" then
		return nil
	end
	return id
end

function KillAllState.isBarrage(): boolean
	local raw: any = nil
	pcall(function()
		raw = LocalPlayer:GetAttribute("Ability2Id")
	end)
	if raw == "BarrageBullet" then
		return true
	end
	local id = ka_bulletEffectId()
	return id == "Barrage"
end

function KillAllState.cooldownLeft(): number
	local start: any = nil
	local dur: any = nil
	pcall(function()
		start = LocalPlayer:GetAttribute("Ability2CooldownStartedAt")
		dur = LocalPlayer:GetAttribute("Ability2CooldownDuration")
	end)
	if type(start) ~= "number" or type(dur) ~= "number" then
		return 0
	end
	if dur ~= dur then
		return 0
	end
	if dur == math.huge then
		local active = false
		pcall(function()
			if KA_AEC ~= nil then
				active = KA_AEC.GetActiveFor("bullet", "Barrage") ~= nil
			end
		end)
		if active then
			return 0
		end
		return math.huge
	end
	if dur <= 0 then
		return 0
	end
	local remain = (start + dur) - os.clock()
	if remain < 0 then
		remain = 0
	end
	return remain
end

function KillAllState.fxOn(): boolean
	if KA_AEC == nil then
		return false
	end
	local ok, fx = pcall(function()
		return KA_AEC.GetActiveFor("bullet", "Barrage")
	end)
	return ok and fx ~= nil
end

function KillAllState.inMatch(): boolean
	local team: any = nil
	pcall(function()
		team = LocalPlayer.Team
	end)
	if team ~= nil and team.Name ~= nil then
		if team.Name == "Lobby" then
			return false
		end
		if team.Name == "A" or team.Name == "B" then
			return true
		end
	end
	local sideOk = false
	pcall(function()
		if LocalPlayer:GetAttribute("MatchSide") ~= nil then
			sideOk = true
		end
		if LocalPlayer:GetAttribute("MatchId") ~= nil then
			sideOk = true
		end
	end)
