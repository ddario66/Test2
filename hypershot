-- SHARED STRICT ENEMY CHECK + MOBILE-FRIENDLY TARGET FINDER
-- ============================================================
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera

local function isEnemyStrict(model: Model): boolean
	if not model or not model:IsA("Model") then return false end
	if model == LocalPlayer.Character then return false end
	if model.Name == LocalPlayer.Name then return false end

	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end

	local plr = Players:FindFirstChild(model.Name)
	if plr and plr:IsA("Player") then
		if plr.Team ~= nil and LocalPlayer.Team ~= nil then
			return plr.Team ~= LocalPlayer.Team
		end
	end

	local mySide = LocalPlayer:GetAttribute("MatchSide")
	local theirSide = model:GetAttribute("MatchSide")
	if mySide ~= nil and theirSide ~= nil then
		return mySide ~= theirSide
	end

	if plr and plr:IsA("Player") then
		return false
	end

	return false
end

-- ★ MOBILE FIXED: nearest enemy by world distance (same logic Kill All uses)
local function getNearestEnemyPart(maxDist: number?): BasePart?
	maxDist = maxDist or 2500
	local folder = Workspace:FindFirstChild("Characters")
	local list = folder and folder:GetChildren() or Workspace:GetChildren()
	local best: BasePart? = nil
	local bestDist = maxDist

	for _, v in ipairs(list) do
		if v:IsA("Model") and v ~= LocalPlayer.Character and isEnemyStrict(v) then
			local part = v:FindFirstChild("Head") or v:FindFirstChild("HumanoidRootPart")
			if part and part:IsA("BasePart") then
				local d = (part.Position - Camera.CFrame.Position).Magnitude
				if d < bestDist then
					best = part
					bestDist = d
				end
			end
		end
	end
	return best
end

