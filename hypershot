	end
	return true
end

function KillAllState.snap()
	pcall(function()
		local t = KillAllState.Target
		if t == nil or t.Parent == nil then
			return
		end
		local cam = workspace.CurrentCamera
		if cam == nil then
			return
		end
		if hasMouseMove then
			local sp, on = cam:WorldToViewportPoint(t.Position)
			if on then
				local vs = cam.ViewportSize
				mousemoverel(sp.X - vs.X / 2, sp.Y - vs.Y / 2)
				task.wait(0.06)
			end
		else
			cam.CFrame = CFrame.lookAt(cam.CFrame.Position, t.Position)
		end
	end)
end

local function ka_waitForBulletEffect(idStr: string?, timeout: number): boolean
	if KA_AEC == nil or idStr == nil then
		task.wait(0.6)
		return false
	end
	local t0 = os.clock()
	while os.clock() - t0 < timeout do
		if not _alive or not KillAllState.Enabled then return false end
		local ok, fx = pcall(function() return KA_AEC.GetActiveFor("bullet", idStr) end)
		if ok and fx ~= nil then
			return true
		end
		task.wait(0.05)
	end
	return false
end

local function ka_fireOnce(): string
	if hasClick then
		local clickFn = mouse1click
		local ok = pcall(function() clickFn() end)
		if ok then return "mouse1click" end
	end
	if vim ~= nil then
		local ok = pcall(function()
			vim:SendMouseButtonEvent(400, 300, 0, true, game, 1)
			task.wait()
			vim:SendMouseButtonEvent(400, 300, 0, false, game, 1)
		end)
		if ok then return "VIM mouse" end
	end
	if ka_tapAction("Attack") then return "tap Attack" end
	return "FAILED"
end

