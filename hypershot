							local dir = part.Position - origin
							local params = RaycastParams.new()
							params.FilterType = Enum.RaycastFilterType.Exclude
							params.IgnoreWater = true
							local ign: { Instance } = { Camera }
							if LocalPlayer.Character then table.insert(ign, LocalPlayer.Character) end
							params.FilterDescendantsInstances = ign
							local hit = Workspace:Raycast(origin, dir.Unit * dir.Magnitude, params)
							if hit == nil or (hit.Instance and hit.Instance:IsDescendantOf(v)) then
								best, bestDist = part, d
							end
						end
					end
				end
			end
		end
		silentTarget = best

		if SilentState.UseFallback and silentTarget then
			local cam = Workspace.CurrentCamera
			if cam then
