-- SPEED BOOST
-- ============================================================
local SpeedSec = Move:Section("⚡ SPEED BOOST")

local SpeedState = {
	Enabled = false,
	Speed = 36,
}
local watchedHum = nil

local function speedGetChar()
	local folder = workspace:FindFirstChild("Characters")
	local c = folder and folder:FindFirstChild(LocalPlayer.Name)
	if c and c.Parent then return c end
	return nil
end

local function speedApply(hum)
	if not SpeedState.Enabled then return end
	if not hum or hum.Health <= 0 then return end
	if hum.WalkSpeed ~= SpeedState.Speed then
		pcall(function() hum.WalkSpeed = SpeedState.Speed end)
	end
end

local function speedRestore()
	local char = speedGetChar()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.WalkSpeed = 28 end) end
end

trackConn(RunService.Stepped:Connect(function()
	if not _alive then return end
	local char = speedGetChar()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum ~= watchedHum then
		watchedHum = hum
		if hum then
			trackConn(hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
				speedApply(hum)
			end))
		end
	end
	speedApply(hum)
end))

trackConn(Gui.Destroying:Connect(function()
	speedRestore()
end))

SpeedSec:Toggle("Speed Boost", false, function(v)
	SpeedState.Enabled = v
	if not v then
		speedRestore()
	end
	Notify("Move", "Speed Boost " .. (v and "ON" or "OFF"), v and T.Green or T.Red)
end)

SpeedSec:Slider("Speed", 16, 60, 36, function(v)
	SpeedState.Speed = v
end)

