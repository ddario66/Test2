	local eGrad = Instance.new("UIGradient")
	eGrad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, T.Purple), ColorSequenceKeypoint.new(1, T.Pink)})
	eGrad.Rotation = 45
	eGrad.Parent = emoteButton

	do
		local drag, dstart, dpos = false, nil, nil
		local moved = false
		trackConn(emoteButton.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				drag = true moved = false dstart = i.Position dpos = emoteButton.Position
			end
		end))
		trackConn(UserInputService.InputChanged:Connect(function(i)
			if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local s = (Scale and Scale.Scale) or 1
				if type(s) ~= "number" or s == 0 then s = 1 end
				local d = (i.Position - dstart) / s
				if (i.Position - dstart).Magnitude > 8 then
					moved = true
					emoteButton.Position = UDim2.new(dpos.X.Scale, dpos.X.Offset + d.X, dpos.Y.Scale, dpos.Y.Offset + d.Y)
				end
			end
		end))
		trackConn(UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				if drag and not moved then main.Visible = not main.Visible end
				drag = false
			end
		end))
	end

	EmoteSec:Toggle("Free Emotes", false, function(v)
		EmoteState.FreeEmotes = v
		if v then enableHooks() else disableHooks() main.Visible = false end
		Notify("Emotes", "Free Emotes " .. (v and "ON" or "OFF"), v and T.Green or T.Red)
	end)
	EmoteSec:Toggle("Emotes GUI", false, function(v)
		EmoteState.EmotesGUI = v
		emoteButton.Visible = v
		if not v then main.Visible = false end
		Notify("Emotes", "Emotes GUI " .. (v and "ON" or "OFF"), v and T.Green or T.Red)
	end)

	trackConn(RunService.Heartbeat:Connect(function()
		if not _alive then return end
		local t = curTrack
		local d = curDef
		if not t or not d then return end
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then stopEmote() return end
		if hum.Health <= 0 then stopEmote() return end
		local st = hum:GetState()
		if st == Enum.HumanoidStateType.Jumping
			or st == Enum.HumanoidStateType.Freefall
			or st == Enum.HumanoidStateType.FallingDown
			or st == Enum.HumanoidStateType.Swimming
			or st == Enum.HumanoidStateType.Dead then
			stopEmote() return
		end
		if hum.MoveDirection.Magnitude > 0.25 and d.Walkable ~= true then stopEmote() return end
	end))

	trackConn(LocalPlayer.CharacterAdded:Connect(function()
		if EmoteState.FreeEmotes then
			stopEmote()
			task.delay(1, fillGameWheel)
		end
	end))

	pcall(function()
		local bindables = RStorage:FindFirstChild("Bindables")
		if bindables then
			local tog = bindables:FindFirstChild("EmoteWheelToggle")
			if tog then
				trackConn(tog.Event:Connect(function()
					if EmoteState.FreeEmotes then task.delay(0.15, fillGameWheel) end
				end))
			end
		end
	end)

	trackConn(Gui.Destroying:Connect(function()
		disableHooks()
		pcall(function() stopEmote() end)
	end))
end

-- INVENTORY INJECTOR
local Injector = (function()
	local lp = LocalPlayer
	local wantedKnife = lp:GetAttribute("KnifeSkin") or "Default"
	local wantedRevolver = lp:GetAttribute("RevolverSkin") or "Default"
	local lastPickKnife, lastPickRevolver = 0, 0

	local function skinNames(folderName)
		local out = {}
		local folder = game.ReplicatedStorage:FindFirstChild(folderName)
		if folder then
			for _, v in ipairs(folder:GetChildren()) do
				if v:IsA("Model") then table.insert(out, v.Name) end
			end
		end
		table.sort(out)
		for i, n in ipairs(out) do
			if n == "Default" then table.remove(out, i) table.insert(out, 1, "Default") break end
		end
		return out
	end

	local knives = skinNames("Knives")
	local revolvers = skinNames("Revolvers")

	do
		local pg = lp:FindFirstChildOfClass("PlayerGui")
		local old = pg and pg:FindFirstChild("SkinGui")
		if old then pcall(function() old:Destroy() end) end
	end

	local invOK, HUD = pcall(function() return lp:WaitForChild("PlayerGui"):WaitForChild("HUD", 10) end)
	local InvWindow, Navigator, Items, MasterTemplate
	if invOK and HUD then
		InvWindow = HUD:FindFirstChild("InventoryWindow")
		if InvWindow then
			Navigator = InvWindow:FindFirstChild("Navigator")
			local ItemContent = InvWindow:FindFirstChild("ItemContent")
			Items = ItemContent and ItemContent:FindFirstChild("Items")
			local Filters = InvWindow:FindFirstChild("Filters")
			MasterTemplate = Filters and Filters:FindFirstChild("ItemTemplate")
		end
	end

	local lastInvTab = "Knives"
	local PREFIX = "WRANGLER_"
	local WIELD_GREEN = Color3.fromRGB(45, 200, 90)

	local function clearInjected()
		if not Items then return end
		for _, ch in ipairs(Items:GetChildren()) do
			if ch.Name:sub(1, #PREFIX) == PREFIX then pcall(function() ch:Destroy() end) end
		end
	end

	local function refreshInvHighlights()
		if not Items then return end
		for _, ch in ipairs(Items:GetChildren()) do
			if ch.Name:sub(1, #PREFIX) == PREFIX and ch:IsA("ImageButton") then
				local skinName = ch:GetAttribute("WranglerSkin")
				local kind = ch:GetAttribute("WranglerKind")
				if skinName and kind then
					local worn = (kind == "Knives" and wantedKnife == skinName)
						or (kind == "Revolvers" and wantedRevolver == skinName)
					local stroke = ch:FindFirstChild("UIStrokeOuter")
					if stroke and stroke:IsA("UIStroke") then
						stroke.Color = worn and WIELD_GREEN or Color3.fromRGB(0, 0, 0)
						stroke.Thickness = worn and 0.06 or 0.03
					end
					local glow = ch:FindFirstChild("Glow")
					if glow then glow.Visible = worn end
				end
			end
		end
	end

	local function fitMiniViewport(vp, cam, kind, skinName)
		local folder = game.ReplicatedStorage:FindFirstChild(kind == "Knives" and "Knives" or "Revolvers")
		local tmpl = folder and folder:FindFirstChild(skinName)
		if not tmpl then return end
		local clone = tmpl:Clone()
		for _, d in ipairs(clone:GetDescendants()) do
			if d.Name == "BoundingBox" and d:IsA("BasePart") then
				d.Transparency = 1
				d.CanCollide = false
				pcall(function() d.CanQuery = false end)
			elseif d:IsA("BasePart") then
				d.CanCollide = false
				d.Anchored = true
			end
		end
		clone.Parent = vp
		local ok, _, size = pcall(function() return clone:GetBoundingBox() end)
		if not ok or not size then return end
		pcall(function() clone:PivotTo(CFrame.new(0, 0.1, 0)) end)
		local biggest = math.max(size.X, size.Y, size.Z, 0.5)
		local dist = biggest * 1.15 + 0.25
		cam.FieldOfView = 50
		cam.CFrame = CFrame.new(Vector3.new(dist * 0.45, dist * 0.32, dist), Vector3.new(0, 0.1, 0))
	end

	local function makeTile(kind, skinName, order)
		if not Items or not MasterTemplate then return end
		local tile = MasterTemplate:Clone()
		tile.Name = PREFIX .. kind .. "_" .. skinName
		tile:SetAttribute("WranglerSkin", skinName)
		tile:SetAttribute("WranglerKind", kind)
		tile.Visible = true
		tile.Active = true
		tile.Selectable = true
		tile.LayoutOrder = order
		local worn = (kind == "Knives" and wantedKnife == skinName)
			or (kind == "Revolvers" and wantedRevolver == skinName)
		local stroke = tile:FindFirstChild("UIStrokeOuter")
		if stroke and stroke:IsA("UIStroke") then
			stroke.Color = worn and WIELD_GREEN or Color3.fromRGB(0, 0, 0)
			stroke.Thickness = worn and 0.06 or 0.03
		end
		local glow = tile:FindFirstChild("Glow")
		if glow then
			glow.Visible = worn
			pcall(function() glow.ImageColor3 = WIELD_GREEN end)
		end
		local insp = tile:FindFirstChild("InspectButton")
		if insp then pcall(function() insp:Destroy() end) end
		local icon = tile:FindFirstChild("Icon")
		if icon and icon:IsA("ImageLabel") then icon.Visible = false end
		local spikes = tile:FindFirstChild("Spikes")
		if spikes then spikes.ZIndex = 4 end
		if glow then glow.ZIndex = 4 end
		local vp = Instance.new("ViewportFrame")
		vp.Name = "WranglerView"
		vp.AnchorPoint = Vector2.new(0.5, 0.5)
		vp.Position = UDim2.new(0.5, 0, 0.5, -4)
		vp.Size = UDim2.new(1, -6, 1, -22)
		vp.BackgroundTransparency = 1
		vp.BorderSizePixel = 0
		vp.ClipsDescendants = true
		vp.ZIndex = 2
		vp.Parent = tile
		local cam = Instance.new("Camera")
		cam.Parent = vp
		vp.CurrentCamera = cam
		pcall(fitMiniViewport, vp, cam, kind, skinName)
		local lbl = Instance.new("TextLabel")
		lbl.Name = "WranglerName"
		lbl.Size = UDim2.new(1, 0, 0, 16)
		lbl.Position = UDim2.new(0, 0, 1, -16)
		lbl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lbl.BackgroundTransparency = 0.4
		lbl.BorderSizePixel = 0
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.TextSize = 10
		lbl.Font = Enum.Font.GothamBold
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.Text = skinName
		lbl.ZIndex = 5
		lbl.Parent = tile
		trackConn(tile.Activated:Connect(function()
			if kind == "Knives" then
				wantedKnife = skinName
				lastPickKnife = os.clock()
				pcall(function() lp:SetAttribute("KnifeSkin", skinName) end)
			else
				wantedRevolver = skinName
				lastPickRevolver = os.clock()
				pcall(function() lp:SetAttribute("RevolverSkin", skinName) end)
			end
			refreshInvHighlights()
		end))
		tile.Parent = Items
	end

	local injectRunning = false
	local function injectInventory()
		if injectRunning then return end
		if not InvWindow or not Items or not MasterTemplate then return end
		if not InvWindow.Visible then return end
		injectRunning = true
		pcall(clearInjected)
		local order = 20000
		local function batch(names, kind)
			for i, n in ipairs(names) do
				order += 1
				pcall(makeTile, kind, n, order)
				if i % 18 == 0 then task.wait() end
			end
		end
		if lastInvTab == "Knives" then batch(knives, "Knives")
		elseif lastInvTab == "Revolvers" then batch(revolvers, "Revolvers") end
		injectRunning = false
	end

	local function scheduleInject(tab)
		lastInvTab = tab
		task.delay(0.45, function()
			if _alive then pcall(injectInventory) end
		end)
	end

	if Navigator and Items then
		local kBtn = Navigator:FindFirstChild("Knives")
		if kBtn and kBtn:IsA("ImageButton") then
			trackConn(kBtn.Activated:Connect(function() scheduleInject("Knives") end))
		end
		local rBtn = Navigator:FindFirstChild("Revolvers")
		if rBtn and rBtn:IsA("ImageButton") then
			trackConn(rBtn.Activated:Connect(function() scheduleInject("Revolvers") end))
		end
		for _, tabName in ipairs({ "All", "Cases", "Finishers", "Emotes" }) do
			local b = Navigator:FindFirstChild(tabName)
			if b and b:IsA("ImageButton") then
				trackConn(b.Activated:Connect(function()
					lastInvTab = tabName
					pcall(clearInjected)
				end))
			end
		end
		trackConn(InvWindow:GetPropertyChangedSignal("Visible"):Connect(function()
			if InvWindow.Visible then
				if lastInvTab == "Knives" or lastInvTab == "Revolvers" then
					scheduleInject(lastInvTab)
				end
			else
				pcall(clearInjected)
			end
		end))
	end

	trackConn(Gui.Destroying:Connect(function() pcall(clearInjected) end))

	pcall(clearInjected)

	local lastPoll = 0
	trackConn(RunService.Heartbeat:Connect(function()
		if not _alive then return end
		pcall(function()
			local now = os.clock()
			local curK = lp:GetAttribute("KnifeSkin")
			if curK ~= wantedKnife then
				if now - lastPickKnife < 10 then lp:SetAttribute("KnifeSkin", wantedKnife)
				elseif curK ~= nil then wantedKnife = curK end
			end
			local curR = lp:GetAttribute("RevolverSkin")
			if curR ~= wantedRevolver then
				if now - lastPickRevolver < 10 then lp:SetAttribute("RevolverSkin", wantedRevolver)
				elseif curR ~= nil then wantedRevolver = curR end
			end
		end)
		local now = os.clock()
		if now - lastPoll > 0.8 then
			lastPoll = now
			pcall(function()
				if InvWindow and InvWindow.Visible and Items then
					if lastInvTab == "Knives" or lastInvTab == "Revolvers" then
						local found = false
						for _, ch in ipairs(Items:GetChildren()) do
							if ch.Name:sub(1, #PREFIX) == PREFIX then found = true break end
						end
						if not found then injectInventory() else refreshInvHighlights() end
					end
				end
			end)
		end
	end))

	local function openTo(tab)
		if not InvWindow then
			Notify("Skins", "Inventory not found", T.Red)
			return false
		end
		pcall(function() InvWindow.Visible = true end)
		if Navigator then
			local btn = Navigator:FindFirstChild(tab)
			if btn and btn:IsA("ImageButton") then pcall(function() btn:Activate() end) end
		end
		scheduleInject(tab)
		return true
	end

	return {
		goKnives = function() return openTo("Knives") end,
		goGuns = function() return openTo("Revolvers") end,
		clearAll = function() pcall(clearInjected) end,
	}
end)()

