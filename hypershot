	barBG.Position = UDim2.new(0, 10, 1, -10)
	barBG.Size = UDim2.new(1, -20, 0, 4)
	barBG.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	barBG.BackgroundTransparency = 0.5
	barBG.BorderSizePixel = 0
	barBG.Parent = n
	corner(barBG, 2)

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 1, 0)
	bar.BackgroundColor3 = accent
	bar.BorderSizePixel = 0
	bar.Parent = barBG
	corner(bar, 2)

	currentNotify = n

	tw(n, 0.15, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	tw(n, 0.2, { Position = UDim2.new(1, 0, 1, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	tw(bar, 2.2, { Size = UDim2.new(0, 0, 1, 0) }, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

	task.delay(2.3, function()
		if currentNotify == n then
			pcall(function()
				tw(n, 0.25, { BackgroundTransparency = 1, Position = UDim2.new(1, 40, 1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				task.wait(0.25)
				if currentNotify == n then
					n:Destroy()
					currentNotify = nil
				end
			end)
		end
	end)
end

-- TABS
local Tabs = {}
local Pages = {}
local TabBtns = {}
local Current = nil
local function applySearch(raw)
	if Current == nil then return end
	local q = string.lower(tostring(raw or ""))
	q = (string.gsub(q, "%s+", ""))
	local pg = Pages[Current]
	if not pg then return end
	for _, child in ipairs(pg:GetChildren()) do
		if child:IsA("GuiObject") then
			local inner = child:FindFirstChild("Inner")
			if inner then
				local titleLbl = child:FindFirstChildOfClass("TextLabel")
				local t = string.lower(titleLbl and titleLbl.Text or "")
				local tmatch = (q == "") or (string.find(t, q, 1, true) ~= nil)
				local anyRow = false
				for _, row in ipairs(inner:GetChildren()) do
					if row:IsA("GuiObject") then
						local s = string.lower(tostring(row:GetAttribute("DSearch") or ""))
						local mm = (q == "") or tmatch or (string.find(s, q, 1, true) ~= nil)
						row.Visible = mm
						if mm then anyRow = true end
					end
				end
				child.Visible = (q == "") or tmatch or anyRow
			else
				local s = string.lower(tostring(child:GetAttribute("DSearch") or ""))
				child.Visible = (q == "") or (string.find(s, q, 1, true) ~= nil)
			end
		end
	end
end
trackConn(Search:GetPropertyChangedSignal("Text"):Connect(function() pcall(applySearch, Search.Text) end))

local function SelectTab(name)
	Current = name
	for tn, btn in pairs(TabBtns) do
		local on = (tn == name)
		tw(btn, 0.15, { BackgroundColor3 = on and T.Orange or T.Row })
		local bar = btn:FindFirstChild("LeftBar")
		if bar then tw(bar, 0.15, { BackgroundTransparency = on and 0 or 1 }) end
		local ring = btn:FindFirstChildOfClass("UIStroke")
		if ring then ring.Color = on and Color3.fromRGB(255,255,255) or Color3.fromRGB(0,0,0) end
	end
	for tn, pg in pairs(Pages) do
		if tn == name then
			pg.Visible = true
			pg.Position = UDim2.new(0, 24, 0, 0)
			tw(pg, 0.22, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			pcall(function() pg.CanvasPosition = Vector2.new(0, 0) end)
		else
			pg.Visible = false
		end
	end
	pcall(applySearch, Search.Text)
	for _, d in ipairs(pipDots) do tw(d, 0.15, { Size = UDim2.new(0, 17, 0, 17) }) end
	task.delay(0.16, function()
		for _, d in ipairs(pipDots) do pcall(function() tw(d, 0.15, { Size = UDim2.new(0, 14, 0, 14) }) end) end
	end)
end

