-- ===== PLAYER ESP =====
local espObjects = {}
local playerESPActive = false
local playerESPConnection = nil
local espRenderConnection = nil

local function worldToScreen(pos)
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	local screenPos, onScreen = camera:WorldToViewportPoint(pos)
	return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

local function createPlayerESP(playerObj)
	local drawings = {}
	drawings.box = Drawing.new("Square")
	drawings.box.Visible = false
	drawings.box.Thickness = 1.5
	drawings.box.Color = Color3.new(1,1,1)
	drawings.box.Filled = false

	drawings.healthBar = Drawing.new("Line")
	drawings.healthBar.Visible = false
	drawings.healthBar.Thickness = 2

	espObjects[playerObj] = drawings
	return drawings
end

local function removePlayerESP(playerObj)
	local drawings = espObjects[playerObj]
	if drawings then
		drawings.box:Remove()
		drawings.healthBar:Remove()
		espObjects[playerObj] = nil
	end
end

local function updatePlayerESP()
	local camera = workspace.CurrentCamera
	if not camera then return end

	for plr, drawings in pairs(espObjects) do
		if not plr or not plr.Parent then
			removePlayerESP(plr)
			continue
		end
		local char = plr.Character
		if not char then
			drawings.box.Visible = false
			drawings.healthBar.Visible = false
			continue
		end
		local head = char:FindFirstChild("Head")
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		if not head or not humanoid or not root then
			drawings.box.Visible = false
			drawings.healthBar.Visible = false
			continue
		end

		local headPos, headOnScreen = worldToScreen(head.Position + Vector3.new(0, 0.5, 0))
		local footPos, footOnScreen = worldToScreen(root.Position - Vector3.new(0, 3, 0))
		if not headOnScreen and not footOnScreen then
			drawings.box.Visible = false
			drawings.healthBar.Visible = false
			continue
		end

		local height = math.abs(footPos.Y - headPos.Y)
		local width = height * 0.6

		if height < 10 then
			height = 10
			width = 6
		end

		local centerX = headPos.X
		local topY = math.min(headPos.Y, footPos.Y)

		drawings.box.Size = Vector2.new(width, height)
		drawings.box.Position = Vector2.new(centerX - width/2, topY)
		drawings.box.Visible = true

		local health = humanoid.Health / humanoid.MaxHealth
		drawings.healthBar.From = Vector2.new(centerX - width/2 - 6, topY)
		drawings.healthBar.To = Vector2.new(centerX - width/2 - 6, topY + height * health)
		drawings.healthBar.Color = health > 0.5 and Color3.new(0,1,0) or (health > 0.25 and Color3.new(1,1,0) or Color3.new(1,0,0))
		drawings.healthBar.Visible = true
	end
end

local function setPlayerESP(on)
	playerESPActive = on
	if on then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and not espObjects[plr] then
				createPlayerESP(plr)
			end
		end
		playerESPConnection = Players.PlayerAdded:Connect(function(plr)
			if plr ~= player and not espObjects[plr] then
				createPlayerESP(plr)
			end
		end)
		Players.PlayerRemoving:Connect(function(plr)
			removePlayerESP(plr)
		end)
		if not espRenderConnection then
			espRenderConnection = RunService.RenderStepped:Connect(updatePlayerESP)
		end
	else
		if playerESPConnection then playerESPConnection:Disconnect(); playerESPConnection = nil end
		for plr, _ in pairs(espObjects) do removePlayerESP(plr) end
		if espRenderConnection then espRenderConnection:Disconnect(); espRenderConnection = nil end
	end
end

