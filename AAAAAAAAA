		if data.highlight then data.highlight:Destroy() end
		if data.billboard then data.billboard:Destroy() end
		if data.distBillboard then data.distBillboard:Destroy() end
		itemESPData[item] = nil
	end
end

local function clearItemESP()
	for item, _ in pairs(itemESPData) do
		removeItemESP(item)
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Highlight") and obj.Name == "ItemESP_Highlight" then
			obj:Destroy()
		elseif obj:IsA("BillboardGui") and (obj.Name == "ItemESP_Name" or obj.Name == "ItemESP_Distance") then
			obj:Destroy()
		end
	end
end

local function refreshItemESP()
	clearItemESP()
	local itemsFolder = workspace:FindFirstChild("_Items")
	if not itemsFolder then return end
	for _, item in ipairs(itemsFolder:GetChildren()) do
		if item:IsA("Model") then
			addItemESP(item)
		end
	end
end

local function updateDistances()
	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local pos = hrp.Position

	for item, data in pairs(itemESPData) do
		if data.distLabel then
			local part
			for _, child in ipairs(item:GetDescendants()) do
				if child:IsA("BasePart") then
					part = child
					break
				end
			end
			if part then
				local dist = math.floor((part.Position - pos).Magnitude)
				data.distLabel.Text = dist .. " studs"
			end
		end
	end
end

local distanceUpdateConnection = nil

local function setItemESP(on)
	itemESPActive = on
	if on then
		refreshItemESP()
		local itemsFolder = workspace:FindFirstChild("_Items")
		if itemsFolder then
			itemConnections.added = itemsFolder.ChildAdded:Connect(function(child)
				if not itemESPActive then return end
				if child:IsA("Model") then
					addItemESP(child)
				end
			end)
			itemConnections.removed = itemsFolder.ChildRemoved:Connect(function(child)
				if child:IsA("Model") then
					removeItemESP(child)
				end
			end)
		end
		if not distanceUpdateConnection then
			distanceUpdateConnection = RunService.Heartbeat:Connect(function()
				if itemESPActive then
					updateDistances()
				end
			end)
		end
	else
		if itemConnections.added then itemConnections.added:Disconnect() end
		if itemConnections.removed then itemConnections.removed:Disconnect() end
		itemConnections = {}
		clearItemESP()
		if distanceUpdateConnection then
			distanceUpdateConnection:Disconnect()
			distanceUpdateConnection = nil
		end
	end
end

