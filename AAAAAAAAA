-- Monster detection (same as Monster ESP)
local function getMonsterTag()
	local success, config = pcall(function()
		return require(game.ReplicatedStorage.Monster.Configuration)
	end)
	if success and config and config.MonsterTag then
		return config.MonsterTag
	end
	return nil
end

local function isMonster(instance)
	if not instance then return false end
	local model = instance
	if not model:IsA("Model") then
		while model and not model:IsA("Model") do
			model = model.Parent
		end
	end
	if not model then return false end
	if model == player.Character then return false end
	if Players:GetPlayerFromCharacter(model) then return false end
	local tag = getMonsterTag()
	if tag then
		return model:HasTag(tag)
	end
	return model:FindFirstChildOfClass("Humanoid") ~= nil
end

-- Shared target detection
local function getTargetAtMouse(targetType)
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	local character = player.Character
	if not character then return nil end
	local mousePos = UserInputService:GetMouseLocation()
	local viewportSize = camera.ViewportSize
	if mousePos.X < 0 or mousePos.X > viewportSize.X or
	   mousePos.Y < 0 or mousePos.Y > viewportSize.Y then
		return nil
	end

	local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {character, camera}
	local maxRange = 1000
	local hitResult = workspace:Raycast(ray.Origin, ray.Direction * maxRange, params)
	if not hitResult then return nil end
	local hitPart = hitResult.Instance
	if not hitPart then return nil end

	if targetType == "Monster" then
		if isMonster(hitPart) then
			return hitPart, hitResult.Position
		end
	elseif targetType == "Player" then
		local model = hitPart
		if not model:IsA("Model") then
			while model and not model:IsA("Model") do
				model = model.Parent
			end
		end
		if model and model ~= character and Players:GetPlayerFromCharacter(model) then
			return hitPart, hitResult.Position
		end
	end
	return nil
end

