local function createToggle(parent, options)
	local toggleFrame = new("Frame", {
		Name = "Toggle_" .. options.text,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
	}, parent)

	new("TextLabel", {
