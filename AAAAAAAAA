-- ===== REMOVE COOL DOWN =====
local originalHoldDurations = {}
local removeCoolDownActive = false
local promptAddedConnection = nil

local function applyRemoveCoolDown(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return end
	if removeCoolDownActive then
		if originalHoldDurations[prompt] == nil then
			originalHoldDurations[prompt] = prompt.HoldDuration
		end
		prompt.HoldDuration = 0
	else
		if originalHoldDurations[prompt] ~= nil then
			prompt.HoldDuration = originalHoldDurations[prompt]
			originalHoldDurations[prompt] = nil
		end
	end
end

local function refreshAllPrompts()
	for _, prompt in ipairs(workspace:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") then
			applyRemoveCoolDown(prompt)
		end
	end
end

local function setRemoveCoolDown(on)
	removeCoolDownActive = on
	if on then
		refreshAllPrompts()
		promptAddedConnection = workspace.DescendantAdded:Connect(function(desc)
			if desc:IsA("ProximityPrompt") then
				applyRemoveCoolDown(desc)
			end
		end)
	else
		if promptAddedConnection then
			promptAddedConnection:Disconnect()
			promptAddedConnection = nil
		end
		refreshAllPrompts()
	end
end

-- ===== NO FALL DAMAGE =====
local noFallDamageActive = false
local noFallDamageConnection = nil
local fallDamageHealth = nil

local function setupNoFallDamage()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	fallDamageHealth = hum.Health
	if noFallDamageConnection then noFallDamageConnection:Disconnect() end
	noFallDamageConnection = hum.HealthChanged:Connect(function()
		if not noFallDamageActive then return end
		local newHealth = hum.Health
		if newHealth < fallDamageHealth then
			local root = char:FindFirstChild("HumanoidRootPart")
			local vel = root and root.AssemblyLinearVelocity
			if vel and vel.Y < -10 then
				hum.Health = fallDamageHealth
			end
		end
		fallDamageHealth = hum.Health
	end)
end

local function toggleNoFallDamage(on)
	noFallDamageActive = on
	if on then
		setupNoFallDamage()
		player.CharacterAdded:Connect(function()
			if noFallDamageActive then
				setupNoFallDamage()
			end
		end)
		print("No Fall Damage: ENABLED")
	else
		if noFallDamageConnection then
			noFallDamageConnection:Disconnect()
			noFallDamageConnection = nil
		end
		print("No Fall Damage: DISABLED")
	end
end

-- ===== REMOVE DOORS =====
local removeDoorsActive = false
local doorOriginalData = {}
local doorAddedConnection = nil

local function applyDoor(part)
	if not part or not part:IsA("BasePart") then return end
	if not removeDoorsActive then return end
	if doorOriginalData[part] then return end
	doorOriginalData[part] = {
		CanCollide = part.CanCollide,
		Transparency = part.Transparency,
	}
	part.CanCollide = false
	part.Transparency = 1
end

local function restoreDoor(part)
	local data = doorOriginalData[part]
	if data then
		part.CanCollide = data.CanCollide
		part.Transparency = data.Transparency
		doorOriginalData[part] = nil
	end
end

local function refreshDoors()
	for part, _ in pairs(doorOriginalData) do
		restoreDoor(part)
	end
	doorOriginalData = {}
	if not removeDoorsActive then return end
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and string.find(string.lower(part.Name), "door") then
			applyDoor(part)
		end
	end
end

local function setupDoorListeners()
	if doorAddedConnection then doorAddedConnection:Disconnect() end
	doorAddedConnection = workspace.DescendantAdded:Connect(function(desc)
		if removeDoorsActive and desc:IsA("BasePart") and string.find(string.lower(desc.Name), "door") then
			applyDoor(desc)
		end
	end)
end

local function toggleRemoveDoors(on)
	removeDoorsActive = on
	if on then
		refreshDoors()
		setupDoorListeners()
		print("Remove Doors: ENABLED")
	else
		for part, _ in pairs(doorOriginalData) do
			restoreDoor(part)
		end
		doorOriginalData = {}
		if doorAddedConnection then
			doorAddedConnection:Disconnect()
			doorAddedConnection = nil
		end
		print("Remove Doors: DISABLED")
	end
end

