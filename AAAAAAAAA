		Position = UDim2.fromOffset(4, 0),
		BackgroundTransparency = 1,
	}, toggleFrame)

	local switchTrack = new("Frame", {
		Size = UDim2.fromOffset(48, 26),
		Position = UDim2.new(1, -54, 0.5, -13),
		BackgroundColor3 = COL.Olive,
		BorderSizePixel = 0,
	}, toggleFrame)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, switchTrack)

	local thumb = new("Frame", {
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = COL.Paper,
		BorderSizePixel = 0,
	}, switchTrack)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, thumb)

	local clicker = new("TextButton", {
		Text = "",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
	}, switchTrack)

	local savedState = toggleStates[options.text]
	local state = (savedState ~= nil) and savedState or (options.defaultState or false)
	local callback = options.callback

	local function setToggle(on)
		state = on
		toggleStates[options.text] = on
		switchTrack.BackgroundColor3 = on and COL.Amber or COL.Olive
		thumb.Position = on and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2)
		if callback then callback(on) end
	end

	clicker.MouseButton1Click:Connect(function()
		setToggle(not state)
	end)

	setToggle(state)

	table.insert(currentContent, toggleFrame)
	return toggleFrame
end

