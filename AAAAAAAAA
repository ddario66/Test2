local dragging = false
local dragStartPos = nil
local boardStartPos = nil
local currentDragInput = nil

dragButton.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStartPos = input.Position
		boardStartPos = board.Position
		currentDragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input == currentDragInput then
		local delta = input.Position - dragStartPos
		board.Position = UDim2.new(
			boardStartPos.X.Scale, boardStartPos.X.Offset + delta.X,
			boardStartPos.Y.Scale, boardStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == currentDragInput then
		dragging = false
		currentDragInput = nil
	end
end)

