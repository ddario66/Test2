-- ===== WALK SPEED BOOST =====
local walkSpeedBoostActive = false
local walkSpeedLoopConnection = nil

local function startWalkSpeedBoost()
	if walkSpeedLoopConnection then return end
	walkSpeedLoopConnection = RunService.Heartbeat:Connect(function()
		if walkSpeedBoostActive then
			local char = player.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then hum.WalkSpeed = 60 end
			end
		end
	end)
end

local function stopWalkSpeedBoost()
	if walkSpeedLoopConnection then
		walkSpeedLoopConnection:Disconnect()
		walkSpeedLoopConnection = nil
	end
	if player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 16 end
	end
end

local function setWalkSpeedBoost(on)
	walkSpeedBoostActive = on
	if on then
		startWalkSpeedBoost()
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum.WalkSpeed = 60 end
		end
	else
		stopWalkSpeedBoost()
	end
end

