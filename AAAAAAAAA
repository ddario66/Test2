local tabNames = {"Main", "Visuals", "Items stuff", "Player", "Other"}
local tabButtons = {}
local activeTab = nil

local function setActiveTab(tabName, button)
	if activeTab == button then return end
	if activeTab then
		activeTab.BackgroundColor3 = COL.Ink
		activeTab.TextColor3 = COL.PaperDim
	end
	activeTab = button
	button.BackgroundColor3 = COL.Amber
	button.TextColor3 = COL.Void
	updateContent(tabName)
end

for _, name in ipairs(tabNames) do
	local btn = new("TextButton", {
		Text = name,
		Font = Enum.Font.SpecialElite,
		TextSize = 14,
		TextColor3 = COL.PaperDim,
		BackgroundColor3 = COL.Ink,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 88, 1, 0),
		BackgroundTransparency = 0,
		AutoButtonColor = false,
	}, tabBar)
	new("UIStroke", { Color = COL.Amber, Transparency = 0.7 }, btn)

	btn.MouseButton1Click:Connect(function()
		setActiveTab(name, btn)
	end)

	table.insert(tabButtons, btn)
end

